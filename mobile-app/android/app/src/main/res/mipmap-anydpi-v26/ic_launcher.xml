<?xml version="1.0" encoding="utf-8"?>
<!--
  Without this, Android 8+ treats ic_launcher.png as a legacy icon: it shrinks
  the square and drops it on a white plate, which is why the wordmark appeared
  floating in the middle of a white background.

  The brand colour is the background layer and the wordmark is the foreground,
  so the icon fills its mask edge to edge whatever shape the launcher uses.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
